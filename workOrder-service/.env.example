# Docker Compose .env syntax: no spaces around "="; quote values containing
# spaces or #; replace every <...> value.
# Do not commit the copied .env file.

# Local development: copy this section to .env.
MYSQL_DATABASE=<local-database-name>
MYSQL_USER=<local-application-user>
MYSQL_PASSWORD=<local-application-password>
MYSQL_ROOT_PASSWORD=<local-root-password>
DB_URL=<local-jdbc-url-using-mysql-host>
TOKEN_SECRET=<long-random-local-token-secret>
SWAGGER_ENABLED=<true-or-false>

# Optional local overrides. Leave REDIS_PASSWORD unset for the unauthenticated
# Redis service in docker-compose.yml; use a separate authenticated Redis setup
# if a local password is required.
# REDIS_PASSWORD=<local-redis-password>
# DRUID_ENABLED=<true-or-false>
# DEVTOOLS_ENABLED=<true-or-false>

# Production: copy only this section to .env.production, replace all values,
# and run docker compose --env-file .env.production -f docker-compose.prod.yml ...
# DB_URL=<managed-mysql-jdbc-url>
# DB_USERNAME=<managed-mysql-application-user>
# DB_PASSWORD=<managed-mysql-password>
# REDIS_HOST=<managed-redis-host>
# REDIS_PORT=<managed-redis-port>
# REDIS_DATABASE=<managed-redis-database-index>
# REDIS_PASSWORD=<managed-redis-password>
# TOKEN_SECRET=<long-random-production-token-secret>
# WORKORDER_UPLOAD_PATH=<container-upload-path>
# CORS_ALLOWED_ORIGINS=<explicit-production-origins>
